{
  "name": "csdl-lop-hoc-hanh-phuc",
  "private": true,
  "version": "1.1.0",
  "description": "Hệ sinh thái quản lý lớp học hạnh phúc thông minh",
  "author": "Nguyễn Thanh Liêm",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "node scripts/build_server.js",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'dist-server', 'dist-electron', 'server.js'].forEach(d => { try { fs.rmSync(d, {recursive: true, force: true}); } catch(_) {} });\"",
    "clean:db": "tsx scripts/clean_database.ts",
    "lint": "tsc --noEmit",
    "build:ico": "node scripts/generate_ico.js",
    "electron:dev": "electron .",
    "build:installer": "npm run build && npm run build:server && npm run build:ico && electron-builder --win --x64",
    "package:win:lite": "node scripts/build-desktop-lite.cjs",
    "desktop:keygen": "node scripts/desktop-update-keygen.cjs",
    "license:keygen": "node scripts/license-keygen.cjs",
    "license:issue": "node scripts/license-issue.cjs",
    "release:desktop-ui": "node scripts/release-desktop-ui.cjs",
    "package:win": "npm run build && npm run build:server && npm run build:ico && electron-builder --win --x64",
    "start:prod": "node dist-server/server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
