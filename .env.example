# ==========================================
# CẤU HÌNH SUPABASE CLOUD DATABASE
# ==========================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ==========================================
# GOOGLE DRIVE DÙNG CHUNG TOÀN TRƯỜNG (tùy chọn)
# Đặt sẵn khi build bản web (Vercel / Railway) để mọi tài khoản
# tự nhận cùng 1 Apps Script + 1 thư mục Drive, không cần cấu hình từng máy.
# ==========================================
VITE_DRIVE_SCRIPT_URL=""
VITE_DRIVE_FOLDER_ID=""

# ==========================================
# CẤU HÌNH GOOGLE GEMINI AI
# ==========================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==========================================
# CẤU HÌNH HỆ THỐNG SERVER
# ==========================================
APP_URL="http://localhost:3000"
PORT=3000
# Railway / máy chủ đám mây: trỏ tới ổ lưu trữ bền vững (Volume), ví dụ /data
# LHHP_DATA_DIR="/data"
NODE_ENV="development"
